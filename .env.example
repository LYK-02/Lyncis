# ==========================================
# Lyncis Environment Variables Configuration
# ==========================================

# Backend Environment
APP_ENV=local
ADMIN_TOKEN=lyncis_admin_secret_token_change_in_production
CORS_ORIGINS=http://localhost:3000

# AISStream Configuration
# Register free key at https://aisstream.io/
AIS_API_KEY=
AIS_BBOX=[[25.0,56.0],[26.5,58.0]]

# OpenSanctions
SANCTIONS_DB_PATH=data/sanctions/sanctions.db

# NASA FIRMS (AeroThermal - Optional)
# Request free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FEATURE_AEROTHERMAL=false

# ShadowTrace (Passive Certificate Transparency - Optional)
FEATURE_SHADOWTRACE=false

# LLM Brief Generation (Optional - falls back to template brief per Rule A5)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_TIMEOUT_S=8

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///data/lyncis.db
REPLAY_DIR=data/replay

# Retention Policies
RETENTION_EVENTS_DAYS=30
RETENTION_TRACKS_HOURS=72

# Frontend (Public)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
